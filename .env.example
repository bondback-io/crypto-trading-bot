# ═══════════════════════════════════════════════════════════════════════════
# Copy to .env for local runs.
# Render: set keys in the Dashboard → Environment.
# Never commit real keys or a filled .env file.
# ═══════════════════════════════════════════════════════════════════════════

# --- Solana RPC (simple 2 paid + 2 public) ---
# Trading ← ALCHEMY_API_KEY
# Data ← HELIUS_API_KEY
# Background ← PUBLICNODE (when background workloads ON)
# Emergency ← RPC_URL (the other public; swaps if Background uses RPC_URL)
#
# 1) Trading — entries, migration, live balance, MEV/send
ALCHEMY_API_KEY=
# ALCHEMY_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY
#
# 2) Data — scanners, signals, market/alpha/zion, metrics/anti-rug
HELIUS_API_KEY=
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
#
# 3) Publics — Background + Emergency (must be two distinct URLs)
# Background prefers PUBLICNODE; Emergency uses RPC_URL (swaps if only one is set).
PUBLICNODE=https://solana-rpc.publicnode.com
RPC_URL=https://api.mainnet-beta.solana.com
#
# Soft-watch Favourites cap (Background lane volume knob). 0 = pause Favourites watch.
# RPC_SOFT_WATCH_CAP=12

# Server (Render injects PORT automatically — leave unset on Render)
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# paper | liveSimulation | live — default Live Sim (virtual fills + live filters)
TRADING_MODE=liveSimulation

# --- Recommended for production ---
# Set ALCHEMY_API_KEY (Trading) + HELIUS_API_KEY (Data) + two distinct publics.

# --- Live trading only (never commit) ---
# Preferred live key env var
TRADING_WALLET_1=
# Optional second / burner wallet
TRADING_WALLET_2=
# Aliases used if TRADING_WALLET_1 is empty (main wallet)
PRIVATE_KEY=
WALLET_PRIVATE_KEY=

# --- Optional APIs (strongly recommended for Discover Smart Wallets) ---
# Without these keys, discovery falls back to Kolscan + curated lists only.
#
# GMGN: create a key at https://gmgn.ai/ai (upload a public key if prompted).
# On Render, also whitelist the service egress IPv4 in the GMGN dashboard if available.
# Prefer the official OpenAPI host (api.gmgn.ai / gmgn.ai web return Cloudflare 403):
GMGN_API_KEY=
GMGN_BASE_URL=https://openapi.gmgn.ai
# Optional alias
# GMGN_OPENAPI_URL=https://openapi.gmgn.ai
#
# Birdeye: create a key at https://birdeye.so → Data API / BDS Dashboard → Security.
# Free/standard plans cover token overview + trending; trader gainers may need a paid tier.
BIRDEYE_API_KEY=
BIRDEYE_BASE_URL=https://public-api.birdeye.so
BIRDEYE_CACHE_MS=90000

# Jupiter Tokens API (trending / toptraded) — https://developers.jup.ag/portal
JUPITER_API_KEY=

# Optional real social APIs (Phase 3) — wire via setSocialApiProvider() in code.
# Without a provider, social_sentiment_filter uses on-chain / Birdeye proxy only.
# SOCIAL_API_KEY=
# SOCIAL_API_PROVIDER=tweetscout|lunarcrush

# Prefer "all" so Kolscan/Dex/Axiom/Photon still fill results when GMGN/Birdeye are down
WALLET_DISCOVERY_SOURCE=all
WALLET_DISCOVERY_CACHE_MS=300000

# Solana Tracker Data API — Axiom + Photon platform leaderboards (free tier available).
# Create a key at https://www.solanatracker.io/account/data-api
# Without this key, Axiom/Photon discovery uses curated fallback only.
SOLANA_TRACKER_API_KEY=
SOLANA_TRACKER_BASE_URL=https://data.solanatracker.io
# Note: BullX Neo trading appears shut down; BullX source returns offline.

# Early Pump.fun curve priority
EARLY_CURVE_MAX_PCT=35
MIN_EARLY_BIRDEYE_SM=40
EARLY_CURVE_MIN_WALLETS=1

# Advanced profit-taking (optional overrides)
# PROFIT_STRATEGY_ENABLED=true
# PROFIT_TAKE_INITIAL_PCT=100
# PROFIT_PARTIAL_AT=80
# PROFIT_PARTIAL_SELL_PCT=50
# PROFIT_TRAIL_AFTER=150
# PROFIT_TRAIL_PCT=25
# PROFIT_BAG_PCT=30
# PROFIT_RISK_ADJUST=true

# Optional CORS for external API clients (dashboard is same-origin by default)
# CORS_ORIGIN=https://your-frontend.example.com

# Jito / MEV (optional — live)
JITO_ENABLED=false
JITO_BLOCK_ENGINE=https://mainnet.block-engine.jito.wtf
JITO_TIP_LAMPORTS=10000
JITO_UUID=
ENABLE_MEV_PROTECTION=false

# Dashboard settings + wallets persist under data/ (config.json, wallets.json,
# trade-profiles-user.json for micro-bot knobs/self-learning, profile-learning/).
# Survives code deploys only when DATA_DIR points at a persistent volume.
# Render: Starter+ Disk mount path must match DATA_DIR exactly — prefer /var/data
# DATA_DIR=/var/data
DATA_DIR=

# --- GitHub site backup (optional) ---
# Semi-auto remote for Settings → Backup → GitHub Backup.
# Fine-grained PAT with Contents: Read and write on a private backups repo only.
# Prefer a SEPARATE private repo (not the Render deploy repo) so uploads never
# trigger auto-deploys. If you must use this repo, backup commits include
# [skip render] and render.yaml ignores site-backups/** — also set Ignored Path
# site-backups/** in Render Dashboard → Build Filters if the service wasn't
# created from the Blueprint.
# Prefer overwriting one file (default path below) — not a full git history dump.
# GITHUB_BACKUP_TOKEN=
# GITHUB_BACKUP_OWNER=your-github-user-or-org
# GITHUB_BACKUP_REPO=my-bot-backups
# GITHUB_BACKUP_PATH=site-backups/site-backup-latest.json

# --- Email notifications (optional) ---
# Recipient defaults to bondback2026@gmail.com (override via NOTIFY_EMAIL or Config UI).
# Without a delivery backend, events still appear in Logs; emails are skipped with a warning.
NOTIFY_EMAIL=bondback2026@gmail.com
NOTIFY_LOW_EQUITY_SOL=1
# NOTIFY_LOW_EQUITY=0
# NOTIFY_INSUFFICIENT_FUNDS=0
# NOTIFY_PROFITABLE_CLOSE=0
#
# Preferred on Render: Resend (https://resend.com) — one API key.
# Free tier works with from=onboarding@resend.dev BUT only to the email on your Resend account.
# To email anyone else (or keep bondback2026@gmail.com if that is NOT your Resend signup email):
#   1) Add + verify a domain at https://resend.com/domains
#   2) Set RESEND_FROM=Crypto Trading Bot <alerts@yourdomain.com>
RESEND_API_KEY=
# RESEND_FROM=Crypto Trading Bot <onboarding@resend.dev>
#
# Alternative: SMTP (Gmail needs an App Password, not your normal password).
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=bondback2026@gmail.com
#   SMTP_PASS=your-16-char-app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_FROM=Crypto Bot <you@example.com>
# SMTP_SECURE=false

# --- Zion lifestyle (optional) ---
# Without this key Zion lists nearby cinemas via OpenStreetMap but will not invent showtimes.
# ZION_CINEMA_SHOWTIMES_API_KEY=
